<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        *{
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body{
            background-color: #f5f5f5;
        }

        /* Navbar */
        .navbar-custom{
            background: white;
            border-bottom: 1px solid #bdbdbd;
            padding: 10px 20px;
        }

        .navbar-brand{
            font-size: 20px;
            font-weight: 500;
        }

        .nav-link{
            color: black !important;
            font-size: 14px;
            margin: 0 12px;
        }

        .nav-icons i {
            font-size: 1.5rem;
            color: #000;
            cursor: pointer;
        }

        /* Dashboard Box */
        .dashboard-wrapper{
            margin: 10px;
            background: #efefef;
            border-radius: 20px;
            min-height: 85vh;
            padding: 20px;
        }

        .dashboard-title{
            text-align: center;
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 20px;
            text-transform: lowercase;
        }

        .welcome-text{
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 20px;
        }

        .role-btn{
            background-color: #f45d01;
            color: white;
            border: none;
            border-radius: 30px;
            padding: 8px 25px;
            font-size: 14px;
            font-weight: 500;
            margin-right: 12px;
            transition: 0.3s;
            text-decoration: none;
            display: inline-block;
        }

        .role-btn:hover{
            background-color: #d94f00;
            color: white;
        }

        .profile-section{
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 22px;
        }

        .stats-card {
            border: 0;
            border-radius: 18px;
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
        }

        .stats-label {
            color: #666;
            font-size: 0.9rem;
            margin-bottom: 6px;
        }

        .stats-value {
            font-size: 1.8rem;
            font-weight: 700;
            line-height: 1;
        }

        .quick-card {
            background: #ffffff;
            border-radius: 18px;
            border: 1px solid #e8e8e8;
            padding: 20px;
            height: 100%;
        }

        .quick-link {
            display: block;
            text-decoration: none;
            color: #111;
            padding: 12px 14px;
            border-radius: 12px;
            background: #f8f8f8;
            margin-bottom: 10px;
            font-weight: 500;
        }

        .quick-link:hover {
            background: #ececec;
            color: #111;
        }
    </style>
    <link rel="stylesheet" href="/clinic-theme.css">
</head>
<body>

    <!-- Navbar -->
    <%- include('partials/navbar') %>

    <!-- Dashboard -->
    <div class="dashboard-wrapper">

        <% if (message && message.length > 0) { %>
            <div class="alert alert-info rounded-4 mb-3"><%= message[0] %></div>
        <% } %>

        <h2 class="dashboard-title">
            admin dashboard
        </h2>

        <h3 class="welcome-text">
            Welcome, <%= adminName || 'Admin Name' %>
        </h3>

        <div class="row g-3 mb-4">
            <div class="col-md-6 col-lg-3">
                <div class="card stats-card">
                    <div class="card-body">
                        <p class="stats-label">Total Patients</p>
                        <p class="stats-value"><%= stats.totalPatients || 0 %></p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card stats-card">
                    <div class="card-body">
                        <p class="stats-label">Total Doctors</p>
                        <p class="stats-value"><%= stats.totalDoctors || 0 %></p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card stats-card">
                    <div class="card-body">
                        <p class="stats-label">Today's Appointments</p>
                        <p class="stats-value"><%= stats.todaysAppointments || 0 %></p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card stats-card">
                    <div class="card-body">
                        <p class="stats-label">Pending Requests</p>
                        <p class="stats-value"><%= stats.pendingRequests || 0 %></p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-6">
                <div class="quick-card">
                    <h5 class="mb-3">Quick Actions</h5>
                    <a href="/admin/patients" class="quick-link">
                        <i class="bi bi-people-fill me-2"></i> Manage Patients
                    </a>
                    <a href="/admin/doctors" class="quick-link">
                        <i class="bi bi-person-vcard-fill me-2"></i> Manage Doctors
                    </a>
                    <a href="/admin/diagnosis-requests" class="quick-link mb-0">
                        <i class="bi bi-clipboard2-pulse-fill me-2"></i> Diagnosis Requests
                    </a>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="quick-card">
                    <h5 class="mb-3">Overview</h5>
                    <p class="mb-2">Diagnosis Requests: <strong><%= stats.diagnosisRequests || 0 %></strong></p>
                    <p class="mb-2">Pending Approvals: <strong><%= stats.pendingRequests || 0 %></strong></p>
                    <p class="mb-0 text-muted">Use the Diagnosis Requests section to approve or reject patient requests.</p>
                </div>
            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>