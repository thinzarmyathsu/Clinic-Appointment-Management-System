<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Personal Information</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <style>
        /* Internal CSS Styling */
        body {
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #ffffff;
            color: #111;
        }

        /* Navbar Styling */
        .navbar {
            padding: 20px 40px;
            border-bottom: 2px solid #000;
            background-color: #fff;
        }
        .navbar-brand {
            font-weight: 700;
            font-size: 1.6rem;
            color: #000 !important;
        }
        .nav-link {
            color: #000;
            font-weight: 600;
            margin: 0 15px;
            font-size: 1rem;
        }
        .nav-link:hover {
            color: #555;
        }
        .nav-icons i {
            font-size: 1.5rem;
            color: #000;
            cursor: pointer;
        }

        /* Profile Card Styling */
        .profile-card {
            background-color: #f8f9fa; /* Light grey background */
            border-radius: 30px;       /* Match wireframe rounded corners */
            padding: 50px 60px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.10); /* Floating shadow */
            max-width: 900px;          /* Widened to fit side-by-side layout */
            width: 100%;
            margin: 40px auto;
        }

        /* Form Element Styling */
        .form-control {
            border-radius: 20px; /* Pill-shaped inputs */
            border: none;        /* Soften the input borders */
            padding: 10px 20px;
            background-color: #ffffff;
        }
        .section-header {
            font-weight: 600;
            font-size: 1.5rem;
            margin-bottom: 30px;
            color: #111;
        }
        .custom-label {
            font-weight: 600;
            font-size: 1.1rem;
        }
        
        /* Save Button Styling */
        .btn-save {
            background-color: #e65100; /* Orange/Red color from wireframe */
            color: #ffffff;
            border-radius: 25px;
            padding: 10px 50px;
            font-weight: 600;
            font-size: 1.1rem;
            border: none;
            transition: all 0.3s ease;
        }
        .btn-save:hover {
            background-color: #cc4800;
            color: #ffffff;
        }
    </style>
    <link rel="stylesheet" href="/clinic-theme.css">
</head>

<body>

    <!-- NAVIGATION BAR -->
    <%- include('partials/navbar') %>

    <!-- PROFILE EDIT SECTION -->
    <div class="container">
        <!-- Wrap the ENTIRE form inside the card -->
        <div class="profile-card">
            
            <form action="/customerInformation" method="POST">
                
                <!-- Section 1: Personal Information -->
                <h2 class="section-header mt-0">Edit Personal Information</h2>
                
                <div class="row mb-4 align-items-center">
                    <label for="name" class="col-md-3 col-form-label custom-label text-md-end">Full Name:</label>
                    <div class="col-md-6">
                        <input type="text" class="form-control" id="name" name="name" value="<%= customer.name %>" required>
                    </div>
                </div>

                <div class="row mb-4 align-items-center">
                    <label for="email" class="col-md-3 col-form-label custom-label text-md-end">Email:</label>
                    <div class="col-md-6">
                        <input type="email" class="form-control" id="email" name="email" value="<%= customer.email %>" required>
                    </div>
                </div>

                <div class="row mb-5 align-items-center">
                    <label for="phone" class="col-md-3 col-form-label custom-label text-md-end">Contact Number:</label>
                    <div class="col-md-6">
                        <input type="text" class="form-control" id="phone" name="phone" value="<%= customer.phone %>" required>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="text-end mt-4">
                    <button type="submit" class="btn-save">Save</button>
                </div>

            </form>
        </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>