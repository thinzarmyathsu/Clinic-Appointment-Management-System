<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Appointment | Clinic Appointment System</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <style>
        /* Internal CSS Styling */
        body {
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #ffffff;
            color: #111;
        }

        /* Navbar Styling */
        .navbar {
            padding: 20px 40px;
            border-bottom: 2px solid #000;
            background-color: #fff;
        }
        .navbar-brand {
            font-weight: 700;
            font-size: 1.6rem;
            color: #000 !important;
        }
        .nav-link {
            color: #000;
            font-weight: 600;
            margin: 0 15px;
            font-size: 1rem;
        }
        .nav-link:hover {
            color: #555;
        }
        .nav-icons i {
            font-size: 1.5rem;
            color: #000;
            cursor: pointer;
        }

        /* Booking Card Styling */
        .booking-card {
            background-color: #f8f9fa; /* Light grey background */
            border-radius: 30px;       
            padding: 50px 60px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.10); 
            max-width: 1000px;         /* Wide enough for two columns */
            width: 100%;
            margin: 40px auto;
        }

        /* Form Element Styling */
        .form-control, .form-select {
            border-radius: 30px; /* Pill-shaped inputs */
            border: none;        
            padding: 12px 20px;
            background-color: #ffffff;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        }
        
        .section-header {
            font-weight: 600;
            font-size: 1.4rem;
            margin-bottom: 20px;
            color: #111;
        }

        .custom-label {
            font-weight: 600;
            font-size: 1.2rem;
            margin-bottom: 10px;
        }
        
        /* Orange Buttons */
        .btn-orange {
            background-color: #e65100; /* Color from your previous code */
            color: #ffffff;
            border-radius: 30px;
            padding: 12px 35px;
            font-weight: 600;
            font-size: 1.1rem;
            border: none;
            transition: all 0.3s ease;
        }
        .btn-orange:hover {
            background-color: #cc4800;
            color: #ffffff;
        }
    </style>
    <link rel="stylesheet" href="/clinic-theme.css">
</head>

<body>

    <!-- NAVIGATION BAR -->
    <%- include('partials/navbar') %>

    <!-- BOOKING SECTION -->
    <div class="container">
        <div class="booking-card">
            <h2 class="text-center fw-bold mb-5">Patient Appointment booking page</h2>
            
            <form action="<%= formAction || '/bookAppointment' %>" method="POST">
                
                <!-- ROW 1: Doctor -->
                <div class="row mb-5">
                    <div class="col-md-6">
                        <label class="custom-label">Doctor</label>
                        <select name="doctorId" class="form-select" required>
                            <option value="" disabled <%= appointment ? '' : 'selected' %>>Select doctor</option>
                            <% if (doctors && doctors.length > 0) { %>
                                <% doctors.forEach(function(doc) { %>
                                    <option value="<%= doc.user_id %>" <%= appointment && String(appointment.doctor_id) === String(doc.user_id) ? 'selected' : '' %>><%= doc.name %></option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                </div>

                <!-- ROW 2: Appointment Slot & Note -->
                <div class="row mb-5">
                    <div class="col-md-6">
                        <h3 class="section-header">Appointment Slot</h3>
                        
                        <div class="d-flex align-items-center mb-3">
                            <label class="custom-label me-3 mb-0" style="width: 60px;">Date:</label>
                            <input type="date" class="form-control" name="appointmentDate" value="<%= appointment ? appointment.appointment_date : '' %>" required>
                        </div>
                        
                        <div class="d-flex align-items-center">
                            <label class="custom-label me-3 mb-0" style="width: 60px;">Time:</label>
                            <input type="time" class="form-control" name="appointmentTime" value="<%= appointment ? appointment.appointment_time : '' %>" required>
                        </div>
                        <br>
                    </div>

                    <div class="col-md-6">
                        <h3 class="section-header">Reason for Visit</h3>
                        <textarea class="form-control" name="reason" rows="5" required><%= appointment ? (appointment.reason || '') : '' %></textarea>
                    </div>
                </div>

                <!-- ROW 4: Buttons aligned to the right -->
                <div class="d-flex justify-content-end gap-3 mt-4">
                    <% if (appointment) { %>
                        <button type="submit" name="removeAppointment" value="1" class="btn btn-orange">Remove appointment</button>
                    <% } %>
                    <!-- type="reset" automatically clears the form fields -->
                    <button type="reset" class="btn btn-orange">Clear Form</button>
                    <!-- type="submit" sends the data to the server -->
                    <button type="submit" class="btn btn-orange"><%= appointment ? 'Update appointment' : 'Book appointment' %></button>
                </div>

            </form>
        </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>