<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Doctor</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #f5f5f5;
        }

        .dashboard-container {
            background: #efefef;
            border-radius: 20px;
            min-height: 85vh;
            padding: 20px;
            margin-top: 10px;
        }

        .dashboard-title {
            text-align: center;
            font-weight: 600;
            margin-bottom: 10px;
            text-transform: lowercase;
        }

        .form-card {
            background: #d4cdc8;
            border-radius: 25px;
            padding: 25px;
            max-width: 820px;
            margin: 25px auto;
        }

        .action-btn {
            background: #f45d01;
            color: white;
            border: none;
            border-radius: 20px;
            padding: 10px 30px;
            font-weight: 600;
            text-decoration: none;
        }

        .action-btn:hover {
            background: #d94f00;
            color: white;
        }
    </style>
    <link rel="stylesheet" href="/clinic-theme.css">
</head>
<body>

<%- include('partials/navbar') %>

<div class="container-fluid">
    <div class="dashboard-container">

        <% if (message && message.length > 0) { %>
            <div class="alert alert-info rounded-4"><%= message[0] %></div>
        <% } %>

        <h2 class="dashboard-title">admin dashboard</h2>
        <h4 class="text-center fw-semibold">Edit Doctor</h4>

        <div class="form-card">
            <form action="/admin/doctor/edit/<%= doctor.id %>" method="POST">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Doctor ID</label>
                    <input type="text" class="form-control" value="<%= doctor.id %>" disabled>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Doctor Name</label>
                    <input type="text" class="form-control" name="name" value="<%= doctor.name %>" required>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Doctor Email</label>
                    <input type="email" class="form-control" name="email" value="<%= doctor.email %>" required>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Doctor Contact Number</label>
                    <input type="text" class="form-control" name="contactNumber" value="<%= doctor.contactNumber %>" required>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Password</label>
                    <input type="text" class="form-control" name="password" placeholder="Leave blank to keep current password">
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="/admin/doctor/<%= doctor.id %>" class="action-btn">Cancel</a>
                    <button type="submit" class="action-btn">Save Changes</button>
                </div>
            </form>
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
