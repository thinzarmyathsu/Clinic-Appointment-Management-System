<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clinic Appointment System</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons (For the profile and chevron icons) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <style>
        /* Internal CSS Styling */

        body {
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #ffffff;
            color: #111;
        }

        /* Navbar Styling */
        .navbar {
            padding: 20px 40px;
            border-bottom: 2px solid #000; /* Crisp border matching wireframe */
            background-color: #fff;
        }
        .navbar-brand {
            font-weight: 700;
            font-size: 1.6rem;
            color: #000 !important;
        }
        .nav-link {
            color: #000;
            font-weight: 600;
            margin: 0 15px;
            font-size: 1rem;
        }
        .nav-link:hover {
            color: #555;
        }
        .nav-icons i {
            font-size: 1.5rem;
            color: #000;
            cursor: pointer;
        }

        /* This class creates the "floating" card effect */
        .login-card {
            background-color: #f8f9fa; /* Light grey background from your wireframe */
            border-radius: 30px;      /* Large border-radius for rounded corners */
            padding: 50px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15); /* The "floating" shadow */
            max-width: 600px;
            width: 100%;
        }

        /* Vertically center the card on the screen */
        .full-height {
            min-height: 80vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .form-control {
            border-radius: 20px; /* Matching the rounded inputs */
        }

    </style>

    

    <link rel="stylesheet" href="/clinic-theme.css">
</head>

<body>

    <!-- NAVIGATION BAR -->
    <%- include('partials/navbar') %>

    <div class="container full-height">
        <div class="login-card">
            <h2 class="text-center mb-4">Login</h2>
            
            <form action="/login" method="POST">
                <div class="mb-3 row align-items-center">
                    <label class="col-sm-3 col-form-label">Email:</label>
                    <div class="col-sm-9">
                        <input type="email" name="email" class="form-control" required>
                    </div>
                </div>

                <div class="mb-3 row align-items-center">
                    <label class="col-sm-3 col-form-label">Password:</label>
                    <div class="col-sm-9">
                        <input type="password" name="password" class="form-control" required>
                    </div>
                </div>

                <div class="mb-4 row align-items-center">
                    <label class="col-sm-3 col-form-label">Login As:</label>
                    <div class="col-sm-9">
                        <select name="role" class="form-select" style="border-radius: 20px;">
                            <option value="patient">Patient</option>
                            <option value="doctor">Doctor</option>
                            <option value="admin">Admin</option>
                        </select>
                    </div>
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-primary px-5" style="border-radius: 20px;">Sign In</button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>