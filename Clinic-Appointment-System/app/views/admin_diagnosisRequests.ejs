<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Diagnosis Requests</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #f5f5f5;
        }

        .dashboard-container {
            background: #efefef;
            border-radius: 20px;
            min-height: 85vh;
            padding: 20px;
            margin-top: 10px;
        }

        .dashboard-title {
            text-align: center;
            font-weight: 600;
            margin-bottom: 10px;
            text-transform: lowercase;
        }

        .welcome-text {
            font-size: 18px;
            font-weight: 600;
        }

        .search-label {
            font-size: 18px;
            font-weight: 600;
            margin-right: 10px;
        }

        .search-input {
            width: 250px;
            display: inline-block;
        }

        .role-btn {
            background: #f45d01;
            color: white;
            border: none;
            border-radius: 25px;
            padding: 8px 25px;
            margin-right: 10px;
            font-size: 14px;
            font-weight: 500;
            text-decoration: none;
        }

        .role-btn:hover {
            background: #d94f00;
            color: white;
        }

        .request-card {
            background: #d4cdc8;
            border-radius: 25px;
            padding: 20px 25px;
            margin-bottom: 20px;
        }

        .request-card p {
            margin-bottom: 8px;
            font-size: 16px;
        }

        .action-row {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 12px;
            flex-wrap: wrap;
        }

        .action-btn {
            background: #f45d01;
            color: white;
            border: none;
            border-radius: 20px;
            padding: 8px 26px;
            text-decoration: none;
            font-weight: 600;
        }

        .action-btn:hover {
            background: #d94f00;
            color: white;
        }

        .reject-btn {
            background: #6c757d;
        }

        .reject-btn:hover {
            background: #5a6268;
        }

        .pill {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 0.85rem;
            font-weight: 600;
            background: #fff;
        }

        .pill.pending {
            color: #9a5700;
        }

        .pill.approved {
            color: #1d7f42;
        }

        .pill.rejected {
            color: #8a2c2c;
        }
    </style>
    <link rel="stylesheet" href="/clinic-theme.css">
</head>
<body>

<%- include('partials/navbar') %>

<div class="container-fluid">
    <div class="dashboard-container">

        <% if (message && message.length > 0) { %>
            <div class="alert alert-info rounded-4"><%= message[0] %></div>
        <% } %>

        <h2 class="dashboard-title">admin dashboard</h2>

        <div class="row align-items-center mb-4">
            <div class="col-md-6">
                <h4 class="welcome-text">Welcome, <%= adminName || 'Admin Name' %></h4>
            </div>
            <div class="col-md-6 text-end">
                <form action="/admin/diagnosis-requests" method="GET">
                    <label class="search-label">search name:</label>
                    <input
                        type="text"
                        name="name"
                        value="<%= searchName || '' %>"
                        class="form-control search-input"
                        placeholder="Search Patient / Doctor">
                </form>
            </div>
        </div>

        <div class="mb-4">
            <a href="/admin/patients" class="role-btn">Patient</a>
            <a href="/admin/doctors" class="role-btn">Doctor</a>
            <a href="/admin/diagnosis-requests" class="role-btn">Diagnosis Requests</a>
        </div>

        <h4 class="fw-semibold mb-4">Diagnosis Requests</h4>
        <div class="mb-4">
            <a href="/admindashboard" class="role-btn">&larr; Back to Dashboard</a>
        </div>

        <% if (requests && requests.length > 0) { %>
            <% requests.forEach(request => { %>
                <div class="request-card">
                    <p><strong>Patient Name:</strong> <%= request.patientName %></p>
                    <p><strong>Doctor Name:</strong> <%= request.doctorName || '-' %></p>
                    <p><strong>Appointment ID:</strong> <%= request.appointmentId %></p>
                    <p><strong>Appointment Date:</strong> <%= request.appointmentDate %></p>
                    <p><strong>Reason for Visit:</strong> <%= request.reason || '-' %></p>
                    <p>
                        <strong>Current Status:</strong>
                        <span class="pill pending"><%= request.status %></span>
                    </p>

                    <div class="action-row">
                        <a href="/admin/appointment/<%= request.appointmentId %>" class="action-btn">View</a>
                        <form action="/admin/diagnosis-requests/<%= request.appointmentId %>/approve" method="POST">
                            <button type="submit" class="action-btn"><i class="bi bi-check-lg me-1"></i>Approve</button>
                        </form>
                        <form action="/admin/diagnosis-requests/<%= request.appointmentId %>/reject" method="POST">
                            <button type="submit" class="action-btn reject-btn"><i class="bi bi-x-lg me-1"></i>Reject</button>
                        </form>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="alert alert-light border rounded-4">No pending diagnosis requests.</div>
        <% } %>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
