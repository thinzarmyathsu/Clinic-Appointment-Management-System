<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Smart Clinic | Clinic Appointment System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body {
            font-family: 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(180deg, #f4fbff 0%, #ffffff 100%);
            color: #163046;
        }

        .contact-page {
            padding: 4rem 0 5rem;
        }

        .contact-shell {
            max-width: 920px;
        }

        .contact-card {
            background: rgba(255, 255, 255, 0.96);
            border: 1px solid rgba(38, 103, 137, 0.08);
        }

        .contact-icon {
            width: 3rem;
            height: 3rem;
            border-radius: 999px;
            background: #e8f5fb;
            color: #0b6e99;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
        }

        .contact-item {
            padding: 1rem 0;
            border-bottom: 1px solid rgba(38, 103, 137, 0.08);
        }

        .contact-item:last-child {
            border-bottom: 0;
            padding-bottom: 0;
        }

        .contact-item:first-child {
            padding-top: 0;
        }

        .section-label {
            color: #0b6e99;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            font-size: 0.78rem;
            font-weight: 700;
        }

        .hours-grid {
            background: #f7fcff;
            border: 1px solid rgba(38, 103, 137, 0.08);
        }
    </style>
    <link rel="stylesheet" href="/clinic-theme.css">
</head>
<body>

    <!-- NAVIGATION BAR -->
    <%- include('partials/navbar') %>
    

    <!-- CONTACT CONTENT -->
    <div class="contact-page">
        <div class="container contact-shell">
            <div class="row justify-content-center">
                <div class="col-12">
                    <div class="card contact-card rounded-4 shadow-sm">
                        <div class="card-body p-4 p-md-5">
                            <div class="row g-4 align-items-start">
                                <div class="col-lg-5">
                                    <span class="section-label d-block mb-2">Contact Smart Clinic</span>
                                    <h1 class="display-6 fw-bold mb-3">We’re here to help.</h1>
                                    <p class="text-secondary mb-4">Feel free to contact us during our operating hours.</p>

                                    <div class="contact-item d-flex align-items-start gap-3">
                                        <div class="contact-icon"><i class="bi bi-telephone-fill"></i></div>
                                        <div>
                                            <div class="fw-semibold">Hotline</div>
                                            <div class="text-secondary">+65 6123 4567</div>
                                        </div>
                                    </div>

                                    <div class="contact-item d-flex align-items-start gap-3">
                                        <div class="contact-icon"><i class="bi bi-whatsapp"></i></div>
                                        <div>
                                            <div class="fw-semibold">WhatsApp</div>
                                            <div class="text-secondary">+65 9123 4567</div>
                                        </div>
                                    </div>

                                    <div class="contact-item d-flex align-items-start gap-3">
                                        <div class="contact-icon"><i class="bi bi-envelope-fill"></i></div>
                                        <div>
                                            <div class="fw-semibold">Email</div>
                                            <div class="text-secondary">smartclinic@gmail.com</div>
                                        </div>
                                    </div>

                                    <div class="contact-item d-flex align-items-start gap-3">
                                        <div class="contact-icon"><i class="bi bi-geo-alt-fill"></i></div>
                                        <div>
                                            <div class="fw-semibold">Clinic Address</div>
                                            <div class="text-secondary">123 Orchard Road<br>Singapore 238888</div>
                                        </div>
                                    </div>

                                    <div class="contact-item d-flex align-items-start gap-3">
                                        <div class="contact-icon"><i class="bi bi-telephone-inbound-fill"></i></div>
                                        <div>
                                            <div class="fw-semibold">Emergency Hotline</div>
                                            <div class="text-secondary">995</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-7">
                                    <div class="hours-grid rounded-4 p-4 p-md-5 h-100">
                                        <div class="d-flex align-items-start gap-3 mb-4">
                                            <div class="contact-icon"><i class="bi bi-clock-fill"></i></div>
                                            <div>
                                                <h2 class="h4 fw-bold mb-1">Operating Hours</h2>
                                                <p class="text-secondary mb-0">Plan your visit around our opening hours below.</p>
                                            </div>
                                        </div>

                                        <div class="row g-3">
                                            <div class="col-12">
                                                <div class="d-flex justify-content-between align-items-center border-bottom pb-2">
                                                    <span class="fw-semibold">Monday – Friday</span>
                                                    <span class="text-secondary">8:00 AM – 8:00 PM</span>
                                                </div>
                                            </div>
                                            <div class="col-12">
                                                <div class="d-flex justify-content-between align-items-center border-bottom pb-2">
                                                    <span class="fw-semibold">Saturday</span>
                                                    <span class="text-secondary">9:00 AM – 5:00 PM</span>
                                                </div>
                                            </div>
                                            <div class="col-12">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <span class="fw-semibold">Sunday</span>
                                                    <span class="text-secondary">10:00 AM – 2:00 PM</span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="mt-4 pt-4 border-top">
                                            <h3 class="h6 fw-bold mb-2">Need Immediate Assistance?</h3>
                                            <p class="text-secondary mb-3">Call us now if you need urgent help from the clinic team.</p>
                                            <a href="tel:+6561234567" class="btn btn-primary btn-lg rounded-pill px-4">
                                                Call Us Now
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>