<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register | Clinic Appointment System</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <style>
        body {
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #ffffff;
            color: #111;
        }

        /* Navbar Styling */
        .navbar {
            padding: 20px 40px;
            border-bottom: 2px solid #000;
            background-color: #fff;
        }
        .navbar-brand {
            font-weight: 700;
            font-size: 1.6rem;
            color: #000 !important;
        }
        .nav-link {
            color: #000;
            font-weight: 600;
            margin: 0 15px;
            font-size: 1rem;
        }
        .nav-link:hover {
            color: #555;
        }
        .nav-icons i {
            font-size: 1.5rem;
            color: #000;
            cursor: pointer;
        }

        /* Floating Card Styling */
        .register-card {
            background-color: #f8f9fa; 
            border-radius: 30px;      
            padding: 50px 60px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15); 
            max-width: 700px;
            width: 100%;
            margin: 20px auto;
        }

        .form-control, .form-select {
            border-radius: 20px; 
            padding: 10px 20px;
            border: none;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        }

        .custom-label {
            font-weight: 500;
            font-size: 1.1rem;
        }
    </style>
    <link rel="stylesheet" href="/clinic-theme.css">
</head>
<body>

    <!-- NAVIGATION BAR -->
    <%- include('partials/navbar') %>

    <div class="container mt-4">
        <!-- Page Title outside the card as per wireframe -->
        <h2 class="fw-bold mb-4 ms-lg-5 ps-lg-5">User registration page</h2>

        <div class="register-card">
            <h2 class="text-center mb-5">User Registration</h2>
            
            <!-- The form will post data to the /register route in app.js -->
            <form action="/register" method="POST">
                
                <div class="mb-4 row align-items-center">
                    <label class="col-sm-4 col-form-label custom-label text-sm-end">Full Name:</label>
                    <div class="col-sm-8">
                        <input type="text" name="name" class="form-control" required>
                    </div>
                </div>

                <div class="mb-4 row align-items-center">
                    <label class="col-sm-4 col-form-label custom-label text-sm-end">Email:</label>
                    <div class="col-sm-8">
                        <input type="email" name="email" class="form-control" required>
                    </div>
                </div>

                <div class="mb-4 row align-items-center">
                    <label class="col-sm-4 col-form-label custom-label text-sm-end">Contact Number:</label>
                    <div class="col-sm-8">
                        <input type="text" name="contact" class="form-control" required>
                    </div>
                </div>
                
                <!-- Added Password field (necessary for a working registration system) -->
                <div class="mb-4 row align-items-center">
                    <label class="col-sm-4 col-form-label custom-label text-sm-end">Password:</label>
                    <div class="col-sm-8">
                        <input type="password" name="password" class="form-control" required>
                    </div>
                </div>

                <div class="mb-5 row align-items-center">
                    <label class="col-sm-4 col-form-label custom-label text-sm-end">Sign up as:</label>
                    <div class="col-sm-8">
                        <select name="role" class="form-select">
                            <option value="patient">Patient</option>
                            <option value="doctor">Doctor</option>
                            <option value="admin">Admin</option>
                        </select>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-dark px-5 py-2" style="border-radius: 25px; font-weight: 600;">Sign Up</button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>